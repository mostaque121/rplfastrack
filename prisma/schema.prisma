generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
  moderator
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(user)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  sessions          Session[]
  accounts          Account[]
  impersonatedUsers Session[] @relation("ImpersonatedSessions")

  @@index([email])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([accessToken])
  @@index([refreshToken])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?
  impersonator   User?   @relation("ImpersonatedSessions", fields: [impersonatedBy], references: [id])

  @@index([token])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Section {
  id                  String   @id @default(cuid())
  title               String
  metaDescription     String
  index               Int
  imageUrl            String // cover photo, wide (about 2:1); also cropped for cards
  imagePublicId       String? // Cloudinary ID; null for images in /public
  link                String   @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  courses             Course[]

  metaTitle String? // SEO title; `title` stays the display title
  heroIntro String? // rich text, 1–2 sentences under the H1
  intro     String? // rich text, 200–400 words of section content
  imageAlt  String?
  icon      String? // Lucide icon name, e.g. "HardHat"
  faqs      Faq[]
}

model Course {
  id                  String       @id @default(cuid())
  title               String
  metaTitle           String       @unique
  metaDescription     String
  index               Int
  imageUrl            String? // cover photo; when empty the page uses the section's image
  imagePublicId       String?
  description         String
  jobOpportunity      String
  entryRequirement    String
  packagingRule       String
  coreUnits           String
  electiveUnits       String
  link                String       @unique
  section             Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId           String
  reviews             UserReview[]

  code             String? // national code, e.g. "CPC40920"
  heroIntro        String? // rich text: unique 2–3 sentence intro
  whoIsItFor       String? // rich text
  evidenceExamples String? // rich text
  licensingInfo    String? // rich text
  duration         String? // e.g. "4–8 weeks"
  deliveryMode     String? // e.g. "Online assessment, Australia-wide"
  searchAliases    String[]      @default([]) // e.g. ["cert 4 plumbing"]; site search and related links, not meta tags
  imageAlt         String?
  isPopular        Boolean       @default(false)
  faqs             Faq[]
  guides           GuideCourse[]

  // Drafts are not in the sitemap and 404 publicly
  status PublishStatus @default(DRAFT)

  // Superseded qualifications show a "replaced by" notice
  qualificationStatus QualificationStatus @default(CURRENT)
  replacedById        String?
  replacedBy          Course?             @relation("CourseReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces            Course[]            @relation("CourseReplacement")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum QualificationStatus {
  CURRENT
  SUPERSEDED
}

// Q&A pairs for a course or a section, rendered with FAQPage schema
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String // rich text
  index     Int      @default(0)
  courseId  String?
  sectionId String?
  guideId   String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  guide     Guide?   @relation(fields: [guideId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([sectionId])
  @@index([guideId])
}

// Long-form articles at /guides/[slug] that answer informational searches
// ("what is RPL") and link to qualification pages.
model Guide {
  id              String        @id @default(cuid())
  title           String // H1
  slug            String        @unique
  metaTitle       String
  metaDescription String
  excerpt         String // plain text, 1–2 sentences: hero intro and guide cards
  body            String // rich text; h2s become the "On this page" list
  imageLink       String? // cover photo (16:9)
  imageAlt        String?
  index           Int           @default(0) // order on /guides
  status          PublishStatus @default(DRAFT)
  publishedAt     DateTime?
  faqs            Faq[]
  courses         GuideCourse[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
}

// Qualifications a guide recommends, in order. Also lists the guide on those course pages.
model GuideCourse {
  guideId  String
  courseId String
  index    Int    @default(0)
  guide    Guide  @relation(fields: [guideId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([guideId, courseId])
  @@index([courseId])
}

model UserReview {
  id                String   @id @default(cuid())
  purchasedCourse   Course   @relation(fields: [purchasedCourseId], references: [id], onDelete: Cascade)
  purchasedCourseId String
  userName          String
  userImage         String?
  reviewImage       String?
  reviewText        String
  givenStar         Int
  approved          Boolean  @default(false)
  reviewDate        DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id String @id @default(uuid())

  invoiceNumber String
  invoiceDate   DateTime
  paymentDue    DateTime

  extraNotes  String?
  gstIncluded Boolean

  bankAccountName   String
  bankAccountNumber String
  bankBSB           String

  billToName  String
  billToEmail String

  items InvoiceItem[]

  total      Decimal
  amountPaid Decimal
  amountDue  Decimal

  pdfLink String
  pdfID   String

  @@index([invoiceDate])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  description String
  quantity    Int
  price       Decimal

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// Backup copy of every form submission; the CRM is the system of record.
// Replaced Response and EligibilitySubmission (dropped 2026-11, export in docs/data/legacy-export-2026-11-06.xlsx).
model Lead {
  id       String   @id @default(cuid())
  form     LeadForm
  name     String
  email    String
  phone    String
  interest String? // qualification / course title
  message  String?
  details  Json? // eligibility answers: industry, yearsOfExperience, state

  // Attribution
  landingPage String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  gclid       String?
  fbclid      String?
  device      String?

  crmStatus CrmSyncStatus @default(PENDING)
  crmError  String?
  createdAt DateTime      @default(now())

  @@index([createdAt])
  @@index([crmStatus])
}

enum LeadForm {
  HERO
  RESPONSE
  ELIGIBILITY
  CONTACT
}

enum CrmSyncStatus {
  PENDING
  SYNCED
  FAILED
}

// Old URL -> new URL (301). Written automatically when a course or section
// link changes in the admin panel; read (cached) only on a 404.
model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique // "/courses/old-slug"
  toPath    String // "/courses/new-slug"
  createdAt DateTime @default(now())
}

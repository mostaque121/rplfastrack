# Environment variables for Vercel (Production and Preview) and local dev.
# Every variable without "optional" is checked by src/env.ts at startup:
# if one is missing, the build fails. Non-secret constants (phone, email,
# address, Facebook, Cloudinary cloud name, site URL, GA4 measurement ID)
# live in src/config/ and are NOT env vars any more.

# --- Database ---------------------------------------------------------------
# Vercel: keep the existing value. Locally a direct postgresql:// URL works
# after `npx prisma generate` (with the engine).
DATABASE_URL= 

# --- Admin sign-in (better-auth, Google only) --------------------------------
BETTER_AUTH_SECRET=
# https://www.rplfastrack.com in Production; leave unset on Preview
BETTER_AUTH_URL= 
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Rate limiting for sign-in
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# --- Email (Brevo) -------------------------------------------------------------
SENDINBLUE_API_KEY=
SENDER_EMAIL=
ADMIN_SENDER_EMAIL=
RECEIVER_EMAIL=

# --- Cloudinary (image uploads) -----------------------------------------------
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# --- Google Analytics 4 Data API (admin analytics) -----------------------------
GOOGLE_PROJECT_ID=
GA4_PROPERTY_ID=
GOOGLE_CLIENT_EMAIL=

# Paste with 
 for line breaks; they are converted back
GOOGLE_PRIVATE_KEY=



# --- CRM lead sync (optional: skipped when unset) ------------------------------
CRM_INTAKE_URL =
CRM_INTAKE_KEY = 

# VERCEL_ENV is set by Vercel automatically; don't add it.
